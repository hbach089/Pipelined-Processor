LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY Substractor_8bits_tb IS
END Substractor_8bits_tb;

architecture testbench of Substractor_8bits_tb is
signal i_Ai_tb, i_Bi_tb:std_logic_vector(7 downto 0);
signal c_in_tb,o_CarryOut_tb:STD_LOGIC;
signal o_Sum_tb	:std_logic_vector(7 downto 0);

	component Substractor_8bits IS
	PORT(i_Ai, i_Bi		: in std_logic_vector(7 downto 0);
		  c_in:in std_logic;
		  o_CarryOut		: OUT	STD_LOGIC;
		  o_Sum			: OUT	std_logic_vector(7 downto 0));
	END component;
begin
	dut:Substractor_8bits
		port map(i_Ai=>i_Ai_tb, 
					i_Bi=>i_Bi_tb,
					c_in=>c_in_tb,
					o_CarryOut=>o_CarryOut_tb,
					o_Sum=>o_Sum_tb);
					
	stim:process
	begin
		c_in_tb<='1';
		i_Ai_tb<="00001100";i_Bi_tb<="00001100";
		wait for 2ns;
		i_Ai_tb<="00100010";i_Bi_tb<="11010000";
		wait for 2ns;
		i_Ai_tb<="01101100";i_Bi_tb<="00000000";
		wait for 2ns;
		i_Ai_tb<="00000000";i_Bi_tb<="11111111";
		wait for 2ns;
		wait;
	end process;

end testbench;
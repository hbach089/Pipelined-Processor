library ieee;
use ieee.std_logic_1164.all;

entity mux_32x1_8bits_tb is
end mux_32x1_8bits_tb;

architecture testbench of mux_32x1_8bits_tb is
signal ipt0_tb,ipt1_Tb,ipt2_tb,ipt3_tb: std_logic_vector(4 downto 0);
signal sel_tb:std_logic_vector(4 downto 0);
signal opt_tb:std_logic_vector(7 downto 0);

component mux_32x1_8bits is
port(ipt0,ipt1,ipt2,ipt3:in std_logic_vector(7 downto 0);
	  sel:in std_logic_vector(4 downto 0);
	  opt:out std_logic_vector(7 downto 0));
end component;

begin
	dut:mux_32x1_8bits
		port map(ipt0=>ipt0_tb,
					ipt1=>ipt1_tb,
					ipt2=>ipt2_tb,
					ipt3=>ipt3_tb,
				   sel=>sel_tb,
				   opt=>opt_tb);
	
	stim:process
	begin
		ipt0_tb<="00000000";ipt1_tb<="11111111";ipt2_tb<="10101010";ipt3_tb<="11110000";
		sel_tb<="00000";
		wait for 2ns;
		sel_tb<="00001";
		wait for 2ns;
		sel_tb<="00010";
		wait for 2ns;
		sel_tb<="00011";
		wait for 2ns;
		wait;
	end process;
		  
		  
end testbench;